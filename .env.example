# ============================================================================
# Copia este archivo a `.env` (nunca se sube al repo). Una variable de entorno SIEMPRE gana sobre el
# valor por defecto del modo. El modo se detecta solo (ver src/config/entorno.ts):
#   1) APP_MODE=oracle|local si viene  2) IP 10.0.1.10 en la máquina -> oracle  3) cualquier otra -> local
# ============================================================================

# ---- Modo (opcional; en Docker del servidor lo fija el docker-compose) ----
# APP_MODE=local
# ORACLE_BACK_IP=10.0.1.10

# ---- Servidor ----
SERVER_PORT=3005
# ENV=development                # oracle: production por defecto

# ---- Base de datos ----
# Defaults  local: localhost:3306, usuario root, sin clave, SSL off
#           oracle: 10.0.1.30:3306, usuario molinos_app, DB_PASSWORD OBLIGATORIA, SSL on
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=molinos_erp_v4
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=false   # HeatWave usa certificado propio de Oracle
# DB_CONNECTION_LIMIT=10

# ---- Seguridad ----
# Obligatorio (32+ caracteres) en oracle/producción. En local sirve el valor por defecto de desarrollo.
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-32-o-mas-caracteres
# TRUST_PROXY=0                  # oracle: 1 (Caddy delante)
# COOKIE_SECURE=false            # oracle: true (HTTPS por Caddy). Escape si el HTTPS falla
SUPER_ADMIN_USERNAME=chris

# ---- CORS ----
# Lista separada por comas. oracle: pon aquí la URL pública del front (FRONT_URL). local: ya se permiten
# localhost y las IP de LAN en 5173/4173/8080. Nunca comodines.
# CORS_ORIGINS=https://1-2-3-4.sslip.io
# FRONT_URL=https://1-2-3-4.sslip.io

# ---- Almacenamiento de archivos ----
# local: STORAGE_DRIVER=disco -> carpeta STORAGE_DIR (MinIO no existe en local)
# oracle: STORAGE_DRIVER=minio -> contenedor `minio` de la VM (nunca público)
# STORAGE_DRIVER=disco
# STORAGE_DIR=./almacenamiento-local
# MINIO_ENDPOINT=minio
# MINIO_PORT=9000
# MINIO_SSL=false
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=molinos-comprobantes

# ---- Correo (recuperación de contraseña) ----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
